# ────────────────────────────────────────────
#  Firebase Config — روضة النجوم
#  انسخ من Firebase Console > Project Settings > Your Apps
# ────────────────────────────────────────────

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id


# ────────────────────────────────────────────
#  🔊 نطق الحروف والكلمات (TTS)
#  اختار مزوّد واحد بس — التطبيق هيكتشفه تلقائيًا.
#  من غير أي مفتاح: التطبيق هيستخدم صوت المتصفح
#  (Web Speech) وجودته ضعيفة في العربي.
#
#  ❗ القرآن مش بيستخدم أي صوت آلي إطلاقًا —
#     بيتشغّل بتلاوة قارئ حقيقي من CDN مجاني.
# ────────────────────────────────────────────

# اختياري: اجبار مزوّد معيّن (google | azure | elevenlabs | openai | none)
# TTS_PROVIDER=auto

# ── 1) Google Cloud Text-to-Speech (أفضل جودة/سعر للعربي) ──
# فعّل Cloud Text-to-Speech API من Google Cloud Console ثم أنشئ API Key
# GOOGLE_TTS_API_KEY=
# GOOGLE_TTS_VOICE_AR=ar-XA-Wavenet-D
# GOOGLE_TTS_VOICE_EN=en-US-Neural2-F

# ── 2) Microsoft Azure Speech (أصوات مصرية ممتازة) ──
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# AZURE_VOICE_AR=ar-EG-SalmaNeural
# AZURE_VOICE_EN=en-US-JennyNeural

# ── 3) ElevenLabs (أصوات طبيعية جدًا — أغلى) ──
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_multilingual_v2

# ── 4) OpenAI ──
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
